---
// Quiz stepper. The server renders every question; the script shows one at a time.
import { QUESTIONS, RESULTS_PATH } from '../data/quiz.js';
const total = QUESTIONS.length;
---
<div class="q-intro" data-quiz-intro>
  <p class="q-lede">{total} pytań, około 2 minut. Na podstawie rządowego <a href="https://www.gov.pl/poradnikbezpieczenstwa" rel="noopener">Poradnika bezpieczeństwa</a>.</p>
  <p class="q-muted">Bez zakładania konta. Odpowiedzi zostają w Twojej przeglądarce, nie zapisujemy ich.</p>
  <button type="button" class="btn btn-accent" data-quiz-start hidden>Zacznij quiz</button>
  <noscript>
    <p><strong>Ten quiz wymaga JavaScriptu.</strong> Możesz za to <a href="/darmowa-karta/">pobrać bezpłatną kartę na lodówkę</a>.</p>
  </noscript>
</div>

<form class="q-card" data-quiz-form data-results-path={RESULTS_PATH} data-total={total} hidden novalidate>
  <div class="q-progress">
    <div class="q-progress__bar" aria-hidden="true"><div class="q-progress__fill" data-quiz-fill></div></div>
    <span class="q-progress__text" data-quiz-progress aria-live="polite">Pytanie 1 z {total}</span>
  </div>

  <!-- Every step sits in the same grid cell, so the card keeps the tallest question's height and
       Back/Next don't move between questions. -->
  <div class="q-steps">
    {QUESTIONS.map((q, i) => (
      <fieldset class="q-step" data-quiz-step={i} hidden={i !== 0}>
        <legend tabindex="-1">{q.text}</legend>
        {q.options.map((label, points) => (
          <label class="q-option">
            <input type="radio" name={q.id} value={points} />
            <span>{label}</span>
          </label>
        ))}
      </fieldset>
    ))}
  </div>

  <div class="q-nav">
    <button type="button" class="btn btn-outline" data-quiz-back>Wstecz</button>
    <button type="button" class="btn btn-accent" data-quiz-next disabled>Dalej</button>
  </div>
</form>

<script>
  import { track } from '../lib/track.js';

  const intro = document.querySelector('[data-quiz-intro]');
  const start = document.querySelector('[data-quiz-start]');
  const form = document.querySelector('[data-quiz-form]');

  if (intro && start && form) {
    const steps = [...form.querySelectorAll('[data-quiz-step]')];
    const total = steps.length;
    const answers = new Array(total).fill(null);
    const backBtn = form.querySelector('[data-quiz-back]');
    const nextBtn = form.querySelector('[data-quiz-next]');
    const progress = form.querySelector('[data-quiz-progress]');
    const fill = form.querySelector('[data-quiz-fill]');
    const resultsPath = form.dataset.resultsPath;
    let current = 0;
    let advanceTimer = 0;

    start.hidden = false;

    function show(i, { focus = true } = {}) {
      clearTimeout(advanceTimer);
      current = i;
      steps.forEach((s, n) => (s.hidden = n !== i));
      progress.textContent = `Pytanie ${i + 1} z ${total}`;
      fill.style.width = `${((i + 1) / total) * 100}%`;
      backBtn.disabled = false;
      backBtn.textContent = i === 0 ? 'Wróć do początku' : 'Wstecz';
      nextBtn.disabled = answers[i] === null;
      nextBtn.textContent = i === total - 1 ? 'Zobacz mój wynik' : 'Dalej';
      if (focus) reveal(steps[i].querySelector('legend'));
    }

    // Bring the card back into view when a step changes. Only scroll when its top has gone under
    // the sticky header; otherwise leave the page where it is so nothing jumps.
    function reveal(target) {
      const header = document.querySelector('.site-header');
      const limit = header ? header.getBoundingClientRect().bottom : 0;
      if (form.getBoundingClientRect().top < limit) form.scrollIntoView({ block: 'start' });
      target.focus({ preventScroll: true });
    }

    function finish() {
      if (answers.some((a) => a === null)) {
        show(answers.indexOf(null));
        return;
      }
      const a = answers.join('');
      track('quiz_completed', {}, { beacon: true });
      window.location.assign(`${resultsPath}?a=${a}`);
    }

    function next() {
      if (answers[current] === null) return;
      if (current === total - 1) finish();
      else show(current + 1);
    }

    start.addEventListener('click', () => {
      intro.hidden = true;
      form.hidden = false;
      show(0);
      track('quiz_started');
    });

    backBtn.addEventListener('click', () => {
      if (current === 0) {
        form.hidden = true;
        intro.hidden = false;
        start.focus();
      } else {
        show(current - 1);
      }
    });

    nextBtn.addEventListener('click', next);

    // Pointer taps move on automatically after a short pause. Keyboard users press Next,
    // so arrow keys can move between options without skipping the question.
    let lastPointer = 0;
    form.addEventListener('pointerdown', () => (lastPointer = Date.now()));

    form.addEventListener('change', (e) => {
      const input = e.target;
      if (!(input instanceof HTMLInputElement) || input.type !== 'radio') return;
      const i = Number(input.closest('[data-quiz-step]').dataset.quizStep);
      answers[i] = Number(input.value);
      if (i !== current) return;
      nextBtn.disabled = false;
      if (Date.now() - lastPointer < 1000) {
        clearTimeout(advanceTimer);
        advanceTimer = window.setTimeout(next, 350);
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      next();
    });
  }
</script>
