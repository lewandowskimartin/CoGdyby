---
// Renders an Amazon affiliate link from a central id (see src/data/affiliateLinks.js).
// Usage in a Markdoc post:  {% alink id="torch" %}A basic LED torch{% /alink %}
// Always marked rel="sponsored nofollow" and opened in a new tab.
import { affiliateUrl } from '../data/affiliateLinks.js';

const { id } = Astro.props;
const href = affiliateUrl(id);

if (!href) {
  // Fail loud in the build log, but don't break the page for a typo'd id.
  console.warn(`[AffiliateLink] unknown affiliate id: "${id}" — rendering plain text.`);
}
---
{href
  ? <a href={href} target="_blank" rel="sponsored nofollow noopener noreferrer"><slot /></a>
  : <slot />}
