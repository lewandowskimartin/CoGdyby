---
import EarlyAccessPromo from './EarlyAccessPromo.astro';
import { publishedAreas } from '../lib/local.js';
import { SELLER } from '../config/seller';
const year = new Date().getFullYear();
// Link to /local/ only once an area page is built (drafts count in dev only).
const hasLocal = (await publishedAreas()).length > 0;
---
<footer>
  <div class="site-footer">
    <div class="fbrand">
      <b>Co gdyby</b>
      <p>Spokojne przygotowanie domu i rodziny na sytuacje kryzysowe. Opieramy się na rządowym <a href="https://www.gov.pl/poradnikbezpieczenstwa" style="color:var(--ink-soft)">Poradniku bezpieczeństwa</a>.</p>
    </div>
    <nav class="fcol" aria-label="Produkt">
      <b>Produkt</b>
      <a href="/darmowa-karta/">Darmowa karta na lodówkę</a>
      <a href="/quiz/" data-quiz-cta="footer">Quiz gotowości</a>
      <a href="/kit/" data-kit-cta="footer">Kalkulator zapasów</a>
      <a href="/#pack" data-pack-cta="footer">Pakiet</a>
      <a href="/#inside" data-pack-cta="footer-inside">Co w środku</a>
      <a href="/blog/">Poradniki</a>
      {hasLocal && <a href="/local/">Poradniki lokalne</a>}
      <EarlyAccessPromo variant="footer" />
    </nav>
    <nav class="fcol" aria-label="Organizacje">
      <b>Dla organizacji</b>
      <a href="/dla-samorzadow/" data-org-cta="footer-whitelabel">Gminy, spółdzielnie, wspólnoty</a>
      <a href="/dla-samorzadow/#probka" data-org-cta="footer-sample">Bezpłatna próbka</a>
      <a href="mailto:kontakt@cogdyby.pl">Kontakt</a>
    </nav>
    <nav class="fcol" aria-label="Więcej">
      <b>Więcej</b>
      <a href="/dla-rodziny/">Dla rodzin</a>
      <a href="/starsi-rodzice/">Dla starszych rodziców</a>
      <a href="/faq/">FAQ</a>
      <a href="/polityka-prywatnosci/">Prywatność</a>
      <a href="/regulamin/">Regulamin</a>
      <button type="button" class="cookie-settings" onclick="window.dispatchEvent(new Event('pah:cookie-settings'))">Ustawienia cookie</button>
    </nav>
  </div>
  <div class="footer-legal">
    <span>© {year} Co gdyby. Niezależny projekt, niezwiązany z administracją publiczną.</span>
    <span>Sprzedawca: {SELLER.NAME}, działający jako {SELLER.TRADING_NAME}, {SELLER.ADDRESS || SELLER.COUNTRY} · <a href={`mailto:${SELLER.EMAIL}`}>{SELLER.EMAIL}</a></span>
    <span>Korzystamy z informacji publicznych z rządowego Poradnika bezpieczeństwa i serwisów gov.pl.</span>
  </div>
</footer>

<style>
  .cookie-settings {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--ink-soft); /* match the sibling links */
    text-align: left;
    cursor: pointer;
  }
  .cookie-settings:hover { color: var(--action); }
</style>
