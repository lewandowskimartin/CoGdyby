---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Clarity from '../components/Clarity.astro';
import Animations from '../components/Animations.astro';
import EarlyAccessPromo from '../components/EarlyAccessPromo.astro';

const { title, description, canonical, image, type } = Astro.props;
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=IBM+Plex+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=IBM+Plex+Mono:wght@400;500&display=swap" /></noscript>
  <Seo title={title} description={description} canonical={canonical} image={image} type={type} />
  <link rel="alternate" type="application/rss+xml" title="Co gdyby — Poradniki" href="/rss.xml" />
  <GoogleAnalytics />
  <Clarity />
  <slot name="head" />
</head>
<body>
  <div class="site-top">
    <EarlyAccessPromo variant="bar" />
    <Header />
  </div>
  <slot />
  <Footer />
  <CookieConsent />
  <Animations />
  <script>
    // Site-wide CTA analytics. One delegated listener for every entry point that appears
    // across pages. No personal data — only the placement label. The actual Payhip checkouts
    // fire their own events (pack_checkout_clicked on the home final CTA, ea_checkout_clicked
    // on the Early Access page); these track the entry-point clicks that lead there.
    import { track, rememberEaSource } from '../lib/track.js';
    import { QUIZ_PATH } from '../data/quiz.js';
    // Literal rather than an import: importing KIT_PATH from data/kit.js pulls the whole kit
    // module (items, copy, scenario prose) into the bundle that loads on every page.
    // Keep in step with KIT_PATH in src/data/kit.js.
    const KIT_PATH = '/kit';
    document.addEventListener('click', (e) => {
      const t = e.target instanceof Element ? e.target : null;
      if (!t) return;

      // Quiz entry points (nav, footer, home hero, bands, guides).
      // Skip clicks made on the quiz itself: those visitors are already in.
      const quiz = t.closest('[data-quiz-cta]');
      if (quiz && !location.pathname.startsWith(QUIZ_PATH))
        track('quiz_cta_clicked', { location: quiz.getAttribute('data-quiz-cta') }, { beacon: true });

      // Kit builder entry points (nav, footer, home band, guides, quiz results, segment pages).
      // Skip clicks made on the builder itself: those visitors are already in.
      const kit = t.closest('[data-kit-cta]');
      const onKit = location.pathname === KIT_PATH || location.pathname.startsWith(KIT_PATH + '/');
      if (kit && !onKit)
        track('kit_cta_clicked', { location: kit.getAttribute('data-kit-cta') }, { beacon: true });

      // "The pack" / "Get the pack" entry points that lead to the pricing section.
      const pack = t.closest('[data-pack-cta]');
      if (pack) track('pack_cta_clicked', { location: pack.getAttribute('data-pack-cta') }, { beacon: true });

      // Early Access course promo (top bar, footer, home card, guide box, free-sample line).
      const ea = t.closest('[data-ea-cta]');
      if (ea) {
        track('ea_cta_clicked', { location: ea.getAttribute('data-ea-cta') }, { beacon: true });
        rememberEaSource(ea.getAttribute('data-ea-cta'));
      }

      // "For organisations" entry points (nav, footer, home button, terms link).
      const org = t.closest('[data-org-cta]');
      if (org) track('org_cta_clicked', { location: org.getAttribute('data-org-cta') }, { beacon: true });

      // White-label enquiry — the organisations conversion (branded-sample mailto).
      const orgEnquiry = t.closest('[data-org-enquiry]');
      if (orgEnquiry) track('org_enquiry_clicked', { location: orgEnquiry.getAttribute('data-org-enquiry') }, { beacon: true });
    });
  </script>
</body>
</html>
