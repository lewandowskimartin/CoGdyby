---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostHog from '../../components/PostHog.astro';
import KitBuilder from '../../components/KitBuilder.astro';
import { SCENARIOS, DEFAULT_SCENARIO } from '../../data/kit.js';
import '../../styles/quiz.css';
import '../../styles/kit.css';

// One page per scenario. /kit already serves the general kit, so it is not repeated here.
export function getStaticPaths() {
  return SCENARIOS.filter((s) => s.id !== DEFAULT_SCENARIO).map((s) => ({
    params: { scenario: s.slug },
    props: { scenario: s },
  }));
}

const { scenario } = Astro.props;
const others = SCENARIOS.filter((s) => s.id !== scenario.id && s.id !== DEFAULT_SCENARIO);
---
<BaseLayout title={`${scenario.seoTitle} | Co gdyby`} description={scenario.seoDescription}>
  <PostHog slot="head" />
  <main id="main">
    <section class="quiz kit-page">
      <span class="eyebrow">Kalkulator zapasów · 3 kroki</span>
      <h1>{scenario.h1}</h1>
      <p class="q-lede">{scenario.blurb} Lista dopasowana do Twojego domu w trzech krokach, bez zakładania konta.</p>
      <KitBuilder scenario={scenario.id} />
      {scenario.intro && (
        <section class="kit-intro">
          <h2>{scenario.intro.heading.split(/(\S+-\S+)/).map((part, i) => (i % 2 ? <span class="kit-keep">{part}</span> : part))}</h2>
          {scenario.intro.paragraphs.map((para) => <p>{para}</p>)}
        </section>
      )}
      {scenario.guide && (
        <p class="kit-guide-link">Więcej w poradniku: <a href={scenario.guide}>{scenario.guideLabel}</a></p>
      )}
      <nav class="kit-more" aria-label="Inne zestawy">
        <h2>Inne zestawy</h2>
        <ul>
          <li><a href="/kit/">Domowy zestaw na 72 godziny</a></li>
          {others.map((s) => (
            <li><a href={`/kit/${s.slug}/`}>{s.navLabel}</a></li>
          ))}
        </ul>
      </nav>
    </section>
  </main>
</BaseLayout>

<style>
  .kit-intro { max-width: 720px; margin-top: 56px; }
  .kit-intro h2 { font-size: 25px; text-wrap: balance; }
  .kit-keep { white-space: nowrap; } /* don't break "72-hour" at its hyphen */
  .kit-intro p { font-size: 16.5px; line-height: 1.65; color: var(--ink-soft); text-wrap: pretty; }
  .kit-guide-link { margin-top: 40px; font-size: 16px; }
  .kit-more { margin-top: 40px; }
  .kit-more h2 { font-size: 21px; }
  .kit-more ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .kit-more a { font-size: 16px; }
</style>
