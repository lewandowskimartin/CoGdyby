---
import BuyButton from "../../components/BuyButton.astro";
// One page per Local Resilience Forum area, built from src/content/local/<area>.yaml.
// Plan: plans/2026-10-14-local-risk-pages.md (page template section). Every fact shown here
// carries a source in the YAML, listed again under "Sources" at the foot of the page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { publishedAreas, nationalContacts, fmtDate } from '../../lib/local.js';
import { PLAN_STEPS, LOCAL_AUTHOR, CORRECTIONS_EMAIL, NOT_AFFILIATED, LOCAL_RELATED, LOCAL_PATH } from '../../data/local.js';
import { PACK_CONFIG } from '../../config/pack';
import { guideHref } from '../../data/related.js';

export async function getStaticPaths() {
  const areas = await publishedAreas();
  return areas.map((entry) => ({ params: { area: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const nat = await nationalContacts();

const title = `${d.searchName ?? d.name}: lokalne zagrożenia i plan na kryzys dla domu`;
const top3 = d.risks.slice(0, 3);
const posts = await getCollection('blog', ({ data }) => !data.draft);
const related = LOCAL_RELATED.map((id) => posts.find((p) => p.id === id)).filter(Boolean);

// The register's own words for a rating, plus the scores where it gives them.
// (Shown under the chip only when the register gives both scores; impact-only is the chip.)
// When the chip already shows the impact score, the line underneath only adds likelihood.
const scoreText = (r) =>
  r.likelihood && r.impact ? (/impact|skutk/i.test(r.rating) ? `prawdopodobieństwo ${r.likelihood} z 5` : `prawdopodobieństwo ${r.likelihood} z 5, skutki ${r.impact} z 5`) : '';
// Chip tone: the register's label where it has one, otherwise its impact score.
const ratingTone = (r) =>
  /bardzo wysok|very high/i.test(r.rating) ? 'vh' : /wysok|high/i.test(r.rating) ? 'h' : r.impact >= 5 ? 'vh' : r.impact === 4 ? 'h' : 'm';

// Every source behind the page, once each, in reading order.
const sources = [];
const addSource = (label, s) => {
  if (s && !sources.some((x) => x.url === s.url)) sources.push({ label: s.title ?? label, url: s.url, checked: s.checked });
};
addSource(d.register.title, d.register.source);
d.risks.forEach((r) => addSource(d.register.title, r.source));
d.power.forEach((p) => addSource(`${p.operator}: awarie i wyłączenia`, p.source));
d.water.forEach((w) => addSource(w.intro ? 'Przedsiębiorstwa wodociągowe' : `${w.company}`, w.source));
d.pastEvents.forEach((e) => addSource(e.name, e.source));
addSource(`${d.lrf.name}`, d.lrf.source);
addSource('Samorządy w regionie', d.councils.source);
addSource('Lokalne radio', d.radio.source);
['emergency', 'power-cut', 'gas'].forEach((id) => nat[id] && addSource(`${nat[id].label} — ${nat[id].number}`, nat[id].source));

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description: d.description,
      dateModified: d.lastChecked.toISOString(),
      author: { '@type': 'Person', name: LOCAL_AUTHOR },
      publisher: { '@type': 'Organization', name: 'Co gdyby', url: 'https://cogdyby.pl' },
      mainEntityOfPage: pageUrl,
      about: { '@type': 'AdministrativeArea', name: d.name },
      spatialCoverage: { '@type': 'AdministrativeArea', name: d.name },
      citation: [{ '@type': 'CreativeWork', name: d.register.title, url: d.register.url }],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: 'Poradniki lokalne', item: new URL(`${LOCAL_PATH}/`, Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: d.name },
      ],
    },
  ],
};
---
<BaseLayout title={`${title} | Co gdyby`} description={d.description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  {d.draft && <meta name="robots" content="noindex" slot="head" />}

  <main id="main">
    <div class="article local">
      <nav class="eyebrow crumbs" aria-label="Nawigacja okruszkowa"><a href="/">Co gdyby</a> · <a href={`${LOCAL_PATH}/`}>Poradniki lokalne</a></nav>
      {d.draft && <p class="draft-flag">Wersja robocza: widoczna tylko w trybie deweloperskim</p>}
      <h1>Plan na kryzys: {d.name}</h1>
      <p class="answer">{d.answer}</p>
      <p class="article-meta">Autor: {LOCAL_AUTHOR} · Sprawdzono {fmtDate(d.lastChecked)}</p>

      <section class="glance" aria-labelledby="glance-h">
        <h2 id="glance-h">W skrócie</h2>
        <ol class="glance-list">
          {top3.map((r) => (
            <li><span class={`chip chip-${ratingTone(r)}`}>{r.rating}</span> <span class="glance-risk">{r.name}</span></li>
          ))}
        </ol>
        <p class="glance-foot">Ocena Co gdyby · {d.register.edition}</p>
      </section>

      <div class="prose">
        <h2>Najważniejsze zagrożenia w regionie</h2>
        <p>Przy każdym zagrożeniu piszemy, co oznacza dla domu i od czego zacząć. Oficjalne komunikaty: <a href={d.lrf.url}>{d.lrf.name}</a>.</p>

        <ul class="risk-list">
          {d.risks.map((r) => (
            <li class="risk">
              <div class="risk-head">
                <h3>{r.name}</h3>
                <span class={`chip chip-${ratingTone(r)}`}>{r.rating}</span>
              </div>
              {scoreText(r) && <p class="risk-score">{scoreText(r)}</p>}
              <dl class="risk-dl">
                <dt>W domu</dt><dd>{r.atHome}</dd>
                <dt>Pierwszy krok</dt><dd>{r.firstAction}</dd>
              </dl>
            </li>
          ))}
        </ul>

        <h2>Powódź: sprawdź swój adres</h2>
        <p>Swoją ulicę sprawdzisz na <a href="https://isok.gov.pl/hydroportal.html">mapach Hydroportalu ISOK</a>, a ostrzeżenia dla rzek na stronie <a href="https://hydro.imgw.pl/">IMGW</a>.</p>

        <h2>Prąd i woda w regionie</h2>
        {d.power.map((p) => (
          <p><strong>{p.operator}</strong>: <a href={p.url}>mapa awarii i powiadomienia o wyłączeniach</a>, zgłoszenia pod <strong>{nat['power-cut']?.number ?? '991'}</strong>.{p.note && ` ${p.note}`}</p>
        ))}
        {d.water.map((w) =>
          w.intro ? (
            <p>{w.intro} <a href={w.url}>Znajdź swoje przedsiębiorstwo wodociągowe</a>.{w.note && ` ${w.note}`}</p>
          ) : (
            <p><strong>{w.company}</strong> ({w.covers ?? 'region'}): <a href={w.url}>przerwy w dostawie</a>{w.phone && `, awarie pod ${w.phone}`}.{w.note && ` ${w.note}`}</p>
          )
        )}
        {d.pastEvents.map((e) => (
          <p class="event"><span class="event-date">{e.date}</span> <strong>{e.name}.</strong> {e.summary}</p>
        ))}

        <h2>Plan na 30 minut dla Twojego domu</h2>
        <p>Pięć kroków, od najważniejszego. Każdy zajmie kilka minut.</p>
        <ol class="plan">
          {d.planOrder.map((id) => {
            const step = PLAN_STEPS[id];
            return (
              <li>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                <p class="plan-local">{d.planNotes[id]}</p>
                {step.link && <p class="plan-link"><a href={step.link.href}>{step.link.label}</a></p>}
              </li>
            );
          })}
        </ol>
      </div>
    </div>

    <div class="article-cta local-cta">
      <div class="box">
        <p>Najważniejsze numery zapisz na karcie na lodówkę.</p>
        <a class="btn btn-primary" href="/darmowa-karta/">Pobierz darmową kartę na lodówkę</a>
      </div>
      <div class="box box-quiet">
        <p>Cały rodzinny plan na papierze: 12-stronicowy pakiet do wydruku.</p>
        <BuyButton class="btn btn-outline" href="/#get" data-pack-cta={`local-${entry.id}`} />
      </div>
    </div>

    <div class="article local local-foot">
      <div class="prose">
        <h2>Lokalne kontakty</h2>
        <ul class="contacts">
          <li><span>Numer alarmowy</span> <strong>112</strong></li>
          {nat['power-cut'] && <li><span>Pogotowie energetyczne</span> <strong>{nat['power-cut'].number}</strong></li>}
          {nat.gas && <li><span>Pogotowie gazowe</span> <strong>{nat.gas.number}</strong></li>}
          <li><span>Pogotowie wodociągowe</span> <strong>994</strong></li>
          <li><span>Policja</span> <strong>997</strong></li>
          <li><span>Straż pożarna</span> <strong>998</strong></li>
          <li><span>Pogotowie ratunkowe</span> <strong>999</strong></li>
        </ul>
        <p><a href={d.lrf.url}>{d.lrf.name}</a>{d.lrf.email && <> · <a href={`mailto:${d.lrf.email}`}>{d.lrf.email}</a></>}</p>
        <p>Urzędy i zarządzanie kryzysowe: {d.councilPages.map((c, i) => <>{i > 0 && ' · '}<a href={c.url}>{c.label}</a></>)}</p>
        <p>Lokalne radio: {d.radio.text}. Samorządy: {d.councils.text}</p>

        <h2>Źródła i metoda</h2>
        <p>Każdy fakt na tej stronie pochodzi z jednego z poniższych źródeł, sprawdzonego w podanej dacie. Widzisz coś nieaktualnego? Napisz na <a href={`mailto:${CORRECTIONS_EMAIL}`}>{CORRECTIONS_EMAIL}</a>.</p>
        <ul class="sources">
          {sources.map((s) => (
            <li><a href={s.url}>{s.label}</a> <span>sprawdzono {fmtDate(s.checked)}</span></li>
          ))}
        </ul>
        <p class="not-affiliated">{NOT_AFFILIATED}</p>
      </div>
    </div>

    <nav class="related" aria-labelledby="related-h">
      <h2 id="related-h">Powiązane poradniki</h2>
      <ul class="post-list">
        <li><a href={`${LOCAL_PATH}/`}><h3>Plany na kryzys dla innych regionów</h3></a></li>
        {related.map((p) => (
          <li><a href={guideHref(p.id)} data-related-guide={p.id}><h3>{p.data.title}</h3></a></li>
        ))}
      </ul>
    </nav>
  </main>
</BaseLayout>

<style>
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .draft-flag { display: inline-block; margin: 0 0 14px; padding: 4px 10px; border-radius: 999px; background: rgba(10, 107, 74, .12); color: var(--action-hover); font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }

  .local h1 { text-wrap: balance; }
  .answer { font-size: 20px; line-height: 1.5; color: var(--ink); margin: 0 0 16px; max-width: 640px; text-wrap: pretty; }

  /* At a glance: the three top risks, on a soft panel like the guide CTA boxes. */
  .glance { background: var(--panel); border: 1px solid var(--hair); border-radius: var(--r-lg); padding: 24px 26px; margin: 0 0 48px; }
  .glance h2 { font-family: var(--mono); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: .14em; color: var(--action); margin: 0 0 14px; }
  /* Two columns (chip, risk) so the risk names line up whatever the chip width. */
  .glance-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: max-content 1fr; align-items: baseline; gap: 10px 12px; }
  .glance-list li { display: contents; font-size: 17px; line-height: 1.4; }
  .glance-list .chip { justify-self: start; }
  .glance-risk { font-weight: 600; color: var(--ink); }
  .glance-foot { margin: 16px 0 0; font-size: 14px; line-height: 1.5; color: var(--ink-soft); }
  .glance-foot a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--action); text-underline-offset: 3px; }

  /* Rating chips: the register's own words. Very high is solid, high outlined, the rest quiet. */
  .chip { flex: none; display: inline-block; padding: 3px 9px; border-radius: 999px; font-family: var(--mono); font-size: 11px; font-weight: 500; line-height: 1.5; text-transform: uppercase; letter-spacing: .06em; white-space: nowrap; }
  .chip-vh { background: var(--action); color: #fff; }
  .chip-h { border: 1px solid var(--action); color: var(--action); }
  .chip-m { border: 1px solid var(--hair); color: var(--muted); background: var(--paper-2); }

  /* Risk list: one row per risk. .prose ul styles are reset here. */
  .prose ul.risk-list { list-style: none; padding: 0; margin-top: 1.4em; border-top: 1px solid var(--hair); }
  .prose .risk { margin: 0; padding: 20px 0; border-bottom: 1px solid var(--hair); }
  .risk-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .prose .risk h3 { margin: 0; font-size: 20px; line-height: 1.3; text-wrap: balance; }
  .prose .risk p { margin: 8px 0 0; font-size: 16px; line-height: 1.6; }
  .prose .risk .risk-score { margin-top: 4px; font-family: var(--mono); font-size: 11.5px; letter-spacing: .04em; color: var(--muted); }
  /* Label column + text column, so wrapped lines stay under their text, not under the label. */
  .risk-dl { display: grid; grid-template-columns: 96px 1fr; gap: 8px 12px; margin: 10px 0 0; }
  .risk-dl dt { font-family: var(--mono); font-size: 11px; line-height: 1.6; padding-top: 3px; text-transform: uppercase; letter-spacing: .08em; color: var(--action); }
  .risk-dl dd { margin: 0; font-size: 16px; line-height: 1.6; }

  .prose .event { padding-left: 16px; border-left: 3px solid var(--hair); }
  .event-date { display: block; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }

  /* The plan: numbered steps; the local note is set apart so it reads as the area's own advice. */
  .prose ol.plan { list-style: none; padding: 0; counter-reset: step; }
  .prose .plan li { counter-increment: step; position: relative; margin: 0; padding: 18px 0 18px 52px; border-top: 1px solid var(--hair); }
  .prose .plan li::before { content: counter(step); position: absolute; left: 0; top: 16px; width: 34px; height: 34px; border-radius: 50%; background: var(--ink); color: var(--paper); font-family: var(--disp); font-weight: 600; font-size: 17px; line-height: 34px; text-align: center; }
  .prose .plan h3 { margin: 0; font-size: 20px; line-height: 1.3; text-wrap: balance; }
  .prose .plan p { margin: 6px 0 0; font-size: 16px; line-height: 1.6; }
  .prose .plan .plan-local { color: var(--ink); background: var(--paper-2); border-radius: var(--r-sm); padding: 10px 14px; margin-top: 10px; }
  .prose .plan .plan-link { font-size: 15px; }

  .article-cta .box + .box { margin-top: 16px; }
  .box-quiet { background: transparent !important; }

  .local-cta { padding-bottom: 24px; }
  .local-foot { padding-top: 24px; }
  .local-foot .prose > h2:first-child { margin-top: 0; }
  .prose ul.contacts { list-style: none; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--hair); }
  .prose .contacts li { display: flex; justify-content: space-between; gap: 16px; margin: 0; padding: 10px 0; border-bottom: 1px solid var(--hair); font-size: 16px; }
  .prose .contacts span { color: var(--ink-soft); }
  .prose .contacts strong { font-family: var(--mono); font-weight: 500; white-space: nowrap; }
  .prose ul.sources { padding-left: 1.1em; font-size: 15px; line-height: 1.55; }
  .prose .sources span { color: var(--muted); font-size: 13px; white-space: nowrap; }
  .not-affiliated { font-size: 14px !important; color: var(--muted); }

  .related { max-width: 720px; margin: 0 auto; padding: 0 var(--pad) 72px; }
  .related h2 { font-family: var(--mono); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: .14em; color: var(--action); margin: 0 0 4px; }
  .related .post-list a { padding: 20px 0; }
  .related .post-list h3 { font-size: 21px; margin: 0; text-wrap: balance; }

  @media (max-width: 560px) {
    .glance { padding: 20px; }
    .answer { font-size: 18px; }
    .risk-dl { grid-template-columns: 1fr; gap: 0; }
    .risk-dl dd + dt { margin-top: 10px; }
  }
</style>
