---
import BuyButton from "../../components/BuyButton.astro";
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostHog from '../../components/PostHog.astro';
import { QUIZ_PATH, EMAIL_FORM, PACK, TIERS, MANAGE, AREAS_HEADING } from '../../data/quiz.js';
import PreparednessGauge from '../../components/PreparednessGauge.astro';
import EarlyAccessPromo from '../../components/EarlyAccessPromo.astro';
import { EA, eaPhase } from '../../config/earlyAccess';
import { publishedAreas } from '../../lib/local.js';
import '../../styles/quiz.css';

const title = 'Twój wynik w quizie gotowości domu | Co gdyby';

// What the share button hands over. Deliberately the quiz page, not this results URL: the
// answers live in ?a=, and nobody should share their own answers by accident. ?src=share
// shows up in analytics without affecting the canonical URL.
const shareUrl = new URL(QUIZ_PATH, Astro.site).href + '?src=share';

// Tier labels come from the data, so the heading and the scoring never drift apart.
const tier = Object.fromEntries(TIERS.map((t) => [t.id, t]));

// Live local pages (slug → name). The household card links to one only if it's published.
const localPages = Object.fromEntries((await publishedAreas()).map((e) => [e.id, e.data?.name ?? e.id]));
---
<BaseLayout title={title} description="Twój wynik w quizie gotowości, najważniejsze braki i bezpłatny sposób na każdy z nich.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
    <PostHog />
  </Fragment>
  <main id="main">
  <section class="quiz" data-results>
    <!-- Shown when ?a= is missing or invalid -->
    <div data-results-error hidden>
      <h1>Nie udało się odczytać tych wyników</h1>
      <p>Link może być niepełny. Przejdź quiz jeszcze raz, a zobaczysz swój wynik. To zajmuje kilka minut.</p>
      <p><a class="btn btn-accent" href={QUIZ_PATH}>Przejdź quiz</a></p>
    </div>

    <noscript>
      <h1>Twój wynik</h1>
      <p>Do wyświetlenia wyniku potrzebny jest JavaScript. Możesz za to <a href="/darmowa-karta/">pobierz darmową kartę na lodówkę</a>.</p>
    </noscript>

    <div data-results-body hidden>
      <span class="eyebrow">Twój wynik</span>
      <h1>Twój wynik gotowości domu</h1>
      <PreparednessGauge />

      <p class="q-manage"><span data-manage-lead>{MANAGE.lead}</span> <strong data-manage-text></strong>.<span class="q-manage__note" data-manage-note></span></p>
      <p class="q-manage__sub">{MANAGE.sub} <a href="/kit/" data-kit-cta="quiz-manage">{MANAGE.kitLabel}</a></p>

      <p data-summary></p>
      <p class="q-muted"><span data-benchmark></span> <a data-benchmark-link rel="noopener">Poradnik bezpieczeństwa na gov.pl</a></p>

      <section class="q-areas" aria-labelledby="q-areas-head">
        <h2 class="q-areas__head" id="q-areas-head">{AREAS_HEADING}</h2>
        <ul class="q-areas__list" data-areas></ul>
      </section>

      <div class="q-share" data-share data-share-url={shareUrl}>
        <p class="q-share__lead">Znasz kogoś, komu ten quiz też się przyda?</p>
        <div class="q-share__row">
          <button type="button" class="btn btn-outline" data-share-btn>Udostępnij wynik</button>
          <span class="q-share__status" role="status" aria-live="polite" data-share-status></span>
        </div>
        <label class="q-share__fallback" data-share-fallback hidden>Skopiuj i wklej, gdzie chcesz
          <input type="text" readonly data-share-input />
        </label>
      </div>

      <div class="q-plan">
        <span class="eyebrow">Twój plan</span>
        <h2>Spokojnie, masz plan.</h2>
        <p class="q-plan__lead" data-plan-lead></p>
        <p class="q-plan__progress" data-plan-progress hidden>
          <span class="q-plan__count" data-plan-count></span>
          <span class="q-plan__note">Odhaczanie zadań nie zmienia wyniku, bo wynik pochodzi z odpowiedzi w quizie.</span>
        </p>

        <section class="q-tier" data-tier="week" hidden>
          <h3 class="q-tier__head">{tier.week.label} <span class="q-tier__note">{tier.week.note}</span></h3>
          <ul class="q-tier__list" data-tier-list></ul>
          <p class="q-tier__cta" data-week-cta hidden><span data-week-cta-text></span> <a href="#pack" data-pack-cta="quiz-tier-week">Zobacz, co jest w pakiecie</a></p>
        </section>

        <section class="q-tier" data-tier="month" hidden>
          <h3 class="q-tier__head">{tier.month.label} <span class="q-tier__note">{tier.month.note}</span></h3>
          <ul class="q-tier__list" data-tier-list></ul>
          <p class="q-tier__cta" data-kit-tier-cta hidden>Nie wiesz, ile kupić? <a href="/kit/" data-kit-tier-link data-kit-cta="quiz-tier-month">Policz to dla swojego domu</a></p>
        </section>

        <section class="q-tier" data-tier="longer" hidden>
          <h3 class="q-tier__head">{tier.longer.label} <span class="q-tier__note">{tier.longer.note}</span></h3>
          <ul class="q-tier__list" data-tier-list></ul>
          {eaPhase() !== 'off' && (
            <p class="q-tier__cta">Kurs „{EA.NAME}” przeprowadzi Cię przez cały plan, jeden krok w tygodniu. <a href="/early-access/" data-ea-cta="quiz-tier-longer">Zobacz kurs</a></p>
          )}
        </section>
      </div>

      <div class="q-card q-home" data-home-card data-local={JSON.stringify(localPages)} hidden>
        <span class="eyebrow">Twój dom</span>
        <h2>Przydatne dla Twojego domu</h2>
        <p class="q-home__profile" data-home-profile></p>
        <ul class="q-home__links" data-home-links></ul>
      </div>

      <EarlyAccessPromo variant="results" />

      {EMAIL_FORM.action && (
        <form class="q-card q-email" method="post" action={EMAIL_FORM.action} data-email-form>
          <h2>Wyślij mi mój plan e-mailem</h2>
          <p>Wyślemy Ci link do tej strony, żeby wynik i plan były zawsze pod ręką.</p>
          <label class="q-field">Adres e-mail
            <input type="email" name="fields[email]" autocomplete="email" required />
          </label>
          <label class="q-check">
            <input type="checkbox" data-consent />
            <span>Chcę też dostawać wskazówki o przygotowaniu domu i informacje o ofertach Co gdyby. Mogę się wypisać w każdej chwili.</span>
          </label>
          <input type="hidden" name="fields[quiz_band]" data-field="band" />
          <input type="hidden" name="fields[quiz_weakest]" data-field="weakest" />
          <input type="hidden" name="fields[quiz_url]" data-field="url" />
          <input type="hidden" name="fields[marketing_consent]" data-field="consent" value="no" />
          <button type="submit" class="btn btn-primary">Wyślij mój plan</button>
          <p class="q-muted" style="margin-top:0.75rem">Szczegóły w <a href="/polityka-prywatnosci/">polityce prywatności</a>. Nie wysyłamy Twoich odpowiedzi z quizu, tylko przedział wyniku, obszar do poprawy i link do wyników.</p>
        </form>
      )}

      <div class="q-card q-offer" id="pack">
        <span class="eyebrow">Pakiet Co gdyby</span>
        <h2 data-offer-heading>Uzupełnij braki w jeden weekend</h2>
        <p data-offer-text></p>
        <div class="q-offer__gaps" data-offer-gaps hidden>
          <p>Strony w pakiecie, które odpowiadają Twoim brakom</p>
          <ul data-offer-gap-list></ul>
        </div>
        <ul>
          {PACK.includes.map((item) => <li>{item}</li>)}
        </ul>
        <div class="q-actions">
          <BuyButton class="btn btn-accent" href={PACK.url} data-pack-link />
        </div>
        <p class="q-offer__reassure">{PACK.reassurance}</p>
      </div>

      <h2>Gdyby coś się stało dziś wieczorem</h2>
      <ul class="q-list">
        <li>Przerwę w dostawie prądu zgłoś na pogotowie energetyczne pod numer <strong>991</strong>. Numeru 112 używaj tylko wtedy, gdy zagrożone jest czyjeś życie, zdrowie lub mienie.</li>
        <li>Nie otwieraj lodówki i zamrażarki bez potrzeby. Zamknięta lodówka trzyma chłód przez około 4 godziny, a pełna zamrażarka nawet do 48 godzin. Więcej w <a href="/blog/co-robic-podczas-przerwy-w-pradzie/">poradniku o przerwach w prądzie</a>.</li>
        <li>Zamiast świec używaj latarki. To bezpieczniejsze, zwłaszcza gdy w domu są dzieci.</li>
        <li>Jeśli poczujesz zapach gazu, nie włączaj światła ani urządzeń, otwórz okna, wyjdź z domu i zadzwoń na pogotowie gazowe <strong>992</strong>.</li>
        <li>Jeśli ktoś w domu korzysta ze sprzętu medycznego zasilanego prądem, warto mieć zapasową baterię i numer do dostawcy sprzętu. Więcej w <a href="/blog/sprzet-medyczny-a-przerwa-w-pradzie/">poradniku o sprzęcie medycznym na prąd</a>.</li>
      </ul>

      <div class="q-card q-free">
        <h2>Na razie wolisz coś prostszego? Zacznij od karty na lodówkę</h2>
        <p>Bezpłatna karta do druku z najważniejszymi numerami i informacjami na wypadek sytuacji kryzysowej.</p>
        <div class="q-actions">
          <a class="btn btn-outline" href={PACK.fallbackUrl} data-free-link>{PACK.fallbackLabel}</a>
        </div>
      </div>

      <p class="q-muted" style="margin-top:2rem">
        Quiz to szybka samoocena, a nie profesjonalny audyt bezpieczeństwa. <a href={QUIZ_PATH}>Przejdź quiz jeszcze raz</a>
      </p>
    </div>
  </section>
  </main>
</BaseLayout>

<script>
  import { parseAnswers, scoreAnswers, parseProfile, encodeProfile, profileFlags } from '../../lib/quizScore.js';
  import { PACK, AREAS, BENCHMARK, MANAGE, PROFILE_STEPS, PROFILE_LINKS, REGIONS } from '../../data/quiz.js';
  import { GAP_KITS, SCENARIOS, kitHref } from '../../data/kit.js';
  import { track } from '../../lib/track.js';

  const $ = (sel) => document.querySelector(sel);
  const params = new URLSearchParams(location.search);
  const answers = parseAnswers(params.get('a'));
  const profile = parseProfile(params.get('p'), params.get('r'));
  const flags = profileFlags(profile);

  if (!answers) {
    $('[data-results-error]').hidden = false;
    track('quiz_results_invalid');
  } else {
    const r = scoreAnswers(answers, { profile });
    // Preparedness gauge — animate reveal (falls back to plain text if the gauge isn't present)
    $('[data-band]').textContent = r.band.label;
    const gaugeCard = document.querySelector('[data-gauge-card]');
    if (gaugeCard) {
      gaugeCard.setAttribute('data-gauge-band', r.band.id);
      const marker = gaugeCard.querySelector('[data-gauge-marker]');
      const scoreEl = gaugeCard.querySelector('[data-score]');
      const scoreSr = gaugeCard.querySelector('[data-score-sr]');
      if (scoreSr) scoreSr.textContent = `${r.total} na 100. ${r.band.label}.`;
      const angle = -90 + (r.total / 100) * 180;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      requestAnimationFrame(() => {
        gaugeCard.classList.add('is-ready');
        if (marker) marker.style.transform = `rotate(${angle}deg)`;
        if (reduced || !scoreEl) {
          if (scoreEl) scoreEl.textContent = String(r.total);
        } else {
          const start = performance.now();
          const dur = 1100;
          const step = (now) => {
            const t = Math.min(1, (now - start) / dur);
            const eased = 1 - Math.pow(1 - t, 3);
            scoreEl.textContent = String(Math.round(r.total * eased));
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      });
    } else {
      $('[data-score]').textContent = String(r.total);
    }
    $('[data-summary]').textContent = r.band.summary;
    $('[data-benchmark]').textContent = BENCHMARK.text;
    $('[data-benchmark-link]').href = BENCHMARK.url;

    // "You'd manage…" — the food and water answers, in the words the visitor picked. The note
    // only appears on the top band, where GOV.UK's "a few days" framing applies.
    if (flags.alone) $('[data-manage-lead]').textContent = MANAGE.leadAlone;
    $('[data-manage-text]').textContent = r.manage.text;
    const manageNote = $('[data-manage-note]');
    if (r.manage.note) manageNote.textContent = r.manage.note;

    // Where you stand: one bar per area, one segment per point. The status word carries the
    // meaning, so nothing rests on colour, and each bar is labelled for screen readers.
    const areasList = $('[data-areas]');
    for (const row of r.areaRows) {
      const li = document.createElement('li');
      li.className = row.isWeakest ? 'q-area is-weakest' : 'q-area';

      const label = document.createElement('span');
      label.className = 'q-area__label';
      label.textContent = row.label;

      const status = document.createElement('span');
      status.className = 'q-area__status';
      status.textContent = row.status;

      const bar = document.createElement('span');
      bar.className = 'q-area__bar';
      bar.setAttribute('role', 'img');
      bar.setAttribute('aria-label', `${row.label}: ${row.score} z ${row.max}. ${row.status}.`);
      for (let i = 0; i < row.max; i++) {
        const seg = document.createElement('span');
        seg.className = i < row.score ? 'q-area__seg is-on' : 'q-area__seg';
        bar.append(seg);
      }

      li.append(label, status, bar);
      areasList.append(li);
    }

    // ---- Your plan: every outstanding action, grouped into three tiers ----
    const areaLabel = Object.fromEntries(AREAS.map((a) => [a.id, a.label]));
    const tierNodes = [...document.querySelectorAll('[data-tier]')];
    const planActions = tierNodes.flatMap((n) => r.plan[n.dataset.tier] ?? []);

    // Ticked actions are stored against this exact set of answers, so retaking the quiz and
    // answering differently starts from a clean list instead of inheriting stale ticks.
    const storeKey = 'pah_plan_' + params.get('a') + (params.get('p') ?? '');
    let ticked;
    try {
      ticked = new Set(JSON.parse(localStorage.getItem(storeKey) || '[]'));
    } catch {
      ticked = new Set(); // private window, or storage blocked
    }
    const saveTicks = () => {
      try {
        localStorage.setItem(storeKey, JSON.stringify([...ticked]));
      } catch {
        /* nothing to do: the list still works for this visit */
      }
    };
    const countEl = $('[data-plan-count]');
    const updateCount = () => {
      countEl.textContent = `${ticked.size} z ${planActions.length} zrobione`;
    };

    const actionRow = (a, tier) => {
      const li = document.createElement('li');
      li.className = 'q-action';
      const label = document.createElement('label');
      label.className = 'q-action__tick';

      const box = document.createElement('input');
      box.type = 'checkbox';
      box.className = 'q-action__input';
      box.checked = ticked.has(a.id);

      const body = document.createElement('span');
      body.className = 'q-action__body';
      const title = document.createElement('span');
      title.className = 'q-action__title';
      title.textContent = a.gap;
      const meta = document.createElement('span');
      meta.className = 'q-action__meta';
      meta.textContent = [a.area ? areaLabel[a.area] : null, a.effort].filter(Boolean).join(' \u00b7 ');
      const fix = document.createElement('span');
      fix.className = 'q-action__fix';
      fix.textContent = a.fix;
      body.append(title, meta, fix);

      // The pack line appears in the first tier only, where the pack is that tier's own CTA.
      // Repeating it under the kit and course tiers would be noise.
      if (a.packPage && tier === 'week') {
        const pack = document.createElement('span');
        pack.className = 'q-action__pack';
        pack.textContent = `W pakiecie: ${a.packPage}`;
        body.append(pack);
      }

      label.append(box, body);
      li.append(label);
      li.classList.toggle('is-done', box.checked);

      box.addEventListener('change', () => {
        if (box.checked) ticked.add(a.id);
        else ticked.delete(a.id);
        li.classList.toggle('is-done', box.checked);
        saveTicks();
        updateCount();
        track('quiz_plan_ticked', { action: a.id, tier, done: box.checked }, { beacon: true });
      });
      return li;
    };

    for (const section of tierNodes) {
      const actions = r.plan[section.dataset.tier] ?? [];
      if (!actions.length) continue;
      const ul = section.querySelector('[data-tier-list]');
      for (const a of actions) ul.append(actionRow(a, section.dataset.tier));
      section.hidden = false;
    }

    // No count in the lead: the progress counter right under it is the number on screen, and
    // two different totals (quiz actions vs every row) on one screen just reads as a mistake.
    const fromQuiz = planActions.filter((a) => !a.standing).length;
    const freeFirst = (r.plan.week ?? []).length ? ' Wszystko z pierwszej listy jest bezpłatne.' : '';
    $('[data-plan-lead]').textContent =
      fromQuiz === 0
        ? 'Na każde pytanie padła odpowiedź „tak”. Te dwie rzeczy pomogą utrzymać ten stan.'
        : 'Wszystko, co pokazał quiz, w kolejności, w jakiej warto się tym zająć.' + freeFirst;
    if (planActions.length) {
      updateCount();
      $('[data-plan-progress]').hidden = false;
    }

    // The pack line under This week counts the actions it genuinely covers. Claiming "every
    // one of these" when a flood-warning sign-up has no pack page would be an overclaim.
    const weekActions = r.plan.week ?? [];
    const covered = weekActions.filter((a) => a.packPage).length;
    if (covered) {
      $('[data-week-cta-text]').textContent =
        covered === weekActions.length
          ? 'Do każdego z tych zadań jest w pakiecie strona do wypełnienia.'
          : `Do ${['', 'jednego', 'dwóch', 'trzech'][covered] ?? covered} z tych zadań jest w pakiecie strona do wypełnienia.`;
      $('[data-week-cta]').hidden = false;
    }

    // The kit builder, pointed at the scenario that closes the first supplies gap in the
    // month tier. A kit is not a plan, so it stays a line inside the tier rather than a card.
    const supplyGaps = (r.plan.month ?? []).filter((a) => GAP_KITS[a.id]);
    if (supplyGaps.length) {
      const scenario = GAP_KITS[supplyGaps[0].id];
      const entry = SCENARIOS.find((s) => s.id === scenario) ?? SCENARIOS[0];
      const link = $('[data-kit-tier-link]');
      link.setAttribute('href', kitHref(scenario));
      link.textContent = `Przygotuj ${entry.listNoun} dla swojego domu`;
      $('[data-kit-tier-cta]').hidden = false;
    }

    // ---- Matched to your home ----
    const homeCard = $('[data-home-card]');
    if (homeCard) {
      const step = (id) => PROFILE_STEPS.find((s) => s.id === id);
      const parts = [];
      if (profile.home) parts.push(step('home').options.find((o) => o.id === profile.home).short);
      if (profile.people) {
        const n = profile.people;
        parts.push(n >= 6 ? '6 lub więcej osób' : n === 1 ? '1 osoba' : n <= 4 ? `${n} osoby` : `${n} osób`);
      }
      const who = step('who').options.filter((o) => profile.who.includes(o.id)).map((o) => o.short);
      if (who.length) parts.push(who.join(', '));
      const region = REGIONS.find((x) => x.id === profile.region);
      if (region) parts.push(region.label);

      const links = PROFILE_LINKS.filter((l) => flags[l.flag]).map((l) => ({ ...l }));
      const live = JSON.parse(homeCard.dataset.local || '{}');
      if (region && live[region.id]) {
        links.unshift({ href: `/local/${region.id}/`, label: `Województwo ${region.label}: lokalne zagrożenia i ważne numery` });
      }

      if (parts.length) {
        $('[data-home-profile]').textContent = `${parts.join(' · ')}. Pytania i porady są dopasowane do tych odpowiedzi.`;
      }
      const ul = $('[data-home-links]');
      for (const l of links) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = l.href;
        a.textContent = l.label;
        a.addEventListener('click', () => track('quiz_home_link', { href: l.href }, { beacon: true }));
        li.append(a);
        ul.append(li);
      }
      // Only worth a card when there's somewhere to go from it.
      homeCard.hidden = links.length === 0;
    }

    // Pack offer: headline by band, plus the pack pages that fix this visitor's gaps.
    const n = r.gaps.length;
    $('[data-offer-heading]').textContent =
      n === 0 ? 'Przenieś plan na papier' : 'Uzupełnij braki w jeden weekend';
    $('[data-offer-text]').textContent = r.band.cta;
    const packPages = [...new Set(r.gaps.map((g) => g.packPage).filter(Boolean))];
    if (packPages.length) {
      const ul = $('[data-offer-gap-list]');
      for (const page of packPages) {
        const li = document.createElement('li');
        li.textContent = page;
        ul.append(li);
      }
      $('[data-offer-gaps]').hidden = false;
    }
    $('[data-pack-link]')?.addEventListener('click', () =>
      track('pack_clicked', { band: r.band.id, score: r.total }, { beacon: true })
    );
    $('[data-free-link]').addEventListener('click', () =>
      track('fridge_card_clicked', { band: r.band.id }, { beacon: true })
    );

    // Ready in 30 — copy by band. Lowest band leads with the course; the others keep the
    // pack as the main ask and read the course as a lighter second option underneath it.
    const course = $('[data-ea-results]');
    if (course && r.band.course) {
      course.querySelector('[data-ea-heading]').textContent = r.band.course.heading;
      course.querySelector('[data-ea-text]').textContent = r.band.course.text;
      const courseLink = course.querySelector('[data-ea-link]');
      // Placement travels in data-ea-cta, not the URL (no ?src= duplicates for crawlers).
      courseLink.setAttribute('data-ea-cta', 'quiz-' + r.band.id); // BaseLayout fires ea_cta_clicked
      if (!r.band.course.lead) {
        // Below the pack, and quieter: the pack is the main ask for anyone scoring 40+.
        course.classList.add('q-course--secondary');
        courseLink.className = 'btn btn-outline';
        $('#pack').after(course);
      }
    }

    // Share your score. Web Share on mobile (and Chrome desktop), clipboard everywhere else,
    // and a selectable field if the clipboard is blocked. The score goes in the text; the link
    // goes to the quiz, never to this page's answers.
    const shareBox = $('[data-share]');
    if (shareBox) {
      const shareText = `Mój wynik: ${r.total}/100. Sprawdź, jak przygotowany jest Twój dom na sytuacje kryzysowe. Quiz zajmuje kilka minut i nie wymaga zapisu:`;
      const shareLink = shareBox.dataset.shareUrl;
      const status = shareBox.querySelector('[data-share-status]');
      const shared = (method) =>
        track('quiz_share', { method, band: r.band.id, score: r.total }, { beacon: true });

      shareBox.querySelector('[data-share-btn]').addEventListener('click', async () => {
        status.textContent = '';
        if (navigator.share) {
          try {
            await navigator.share({ title: 'Quiz gotowości domu', text: shareText, url: shareLink });
            shared('web_share');
            return;
          } catch (err) {
            if (err && err.name === 'AbortError') return; // they changed their mind
          }
        }
        try {
          await navigator.clipboard.writeText(`${shareText} ${shareLink}`);
          status.textContent = 'Skopiowano. Możesz wkleić, gdzie chcesz.';
          shared('clipboard');
          return;
        } catch {
          /* clipboard blocked — fall through to the manual field */
        }
        const field = shareBox.querySelector('[data-share-input]');
        field.value = `${shareText} ${shareLink}`;
        shareBox.querySelector('[data-share-fallback]').hidden = false;
        field.focus();
        field.select();
        shared('manual');
      });
    }

    const emailForm = $('[data-email-form]');
    if (emailForm) {
      emailForm.querySelector('[data-field="band"]').value = r.band.id;
      emailForm.querySelector('[data-field="weakest"]').value = r.weakest ?? '';
      const emailParams = new URLSearchParams({ a: params.get('a') });
      const emailProfile = encodeProfile(profile, { drop: ['s', 'c'] });
      if (emailProfile) emailParams.set('p', emailProfile);
      if (profile.region) emailParams.set('r', profile.region);
      emailForm.querySelector('[data-field="url"]').value = location.origin + location.pathname + '?' + emailParams;
      const consent = emailForm.querySelector('[data-consent]');
      const consentField = emailForm.querySelector('[data-field="consent"]');
      consent.addEventListener('change', () => (consentField.value = consent.checked ? 'yes' : 'no'));
      emailForm.addEventListener('submit', () =>
        track('quiz_email_submitted', { band: r.band.id, marketing_consent: consent.checked }, { beacon: true })
      );
    }

    $('[data-results-body]').hidden = false;
    track('quiz_results_viewed', { score: r.total, band: r.band.id, weakest: r.weakest ?? 'none' });
  }
</script>
