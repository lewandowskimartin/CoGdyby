# Build-time settings. Astro bakes PUBLIC_* values into the site when it builds,
# so after changing anything here, restart `npm run dev` (or rebuild).
# Production: set the same names as build variables in Cloudflare, then redeploy.

# PostHog (EU project, "Cookieless server hash mode" on). Empty = PostHog off.
PUBLIC_POSTHOG_KEY=
# Optional, defaults to https://eu.i.posthog.com
# PUBLIC_POSTHOG_HOST=

# MailerLite embedded-form action URL for "Email me my results". Empty = email step hidden.
PUBLIC_MAILERLITE_ACTION=
